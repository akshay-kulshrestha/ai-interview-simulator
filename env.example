# Copy this file to .env and adjust as needed. Values here are the same
# defaults already baked into the code -- uncomment/edit only what you want
# to change. Never commit your actual .env (add it to .gitignore).

# ---------------------------------------------------------------- Ollama ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# If generation keeps timing out/truncating on your hardware, llama3.2:1b is
# roughly 3x smaller and generates significantly faster on CPU-only setups.
# OLLAMA_MODEL=llama3.2:1b
# OLLAMA_REQUEST_TIMEOUT=90
# OLLAMA_KEEP_ALIVE=30m

# ------------------------------------------------- generation length caps --
# Raising these gives the model more room per call (less truncation risk)
# at the cost of slower responses; lowering speeds things up but raises
# truncation risk. See ai_analyzer.py for how these interact.
# WARMUP_NUM_PREDICT=10
# QUESTION_NUM_PREDICT=90
# HINTS_NUM_PREDICT=120
# ANALYSIS_NUM_PREDICT=450
# SUMMARY_NUM_PREDICT=220

# ------------------------------------------------------- retries & counts --
# QUESTION_GENERATION_ATTEMPTS=3
# HINTS_GENERATION_ATTEMPTS=2
# MAX_HINTS=3
# MAX_STRENGTHS=6
# MAX_SUGGESTIONS=6
# PROMPT_LIST_ITEM_COUNT=2
# IMPROVED_ANSWER_MAX_WORDS=70
# MIN_IMPROVED_ANSWER_WORDS=8

# --------------------------------------------------------------- storage ---
# DATABASE_PATH=./data/interviews.db
# DB_BUSY_TIMEOUT_MS=5000
# REPORTS_DIR=./reports

# ------------------------------------------------------------------- app ---
# PORT=5001
# FLASK_DEBUG=0
# SCORE_RING_SIZE=96
# SCORE_RING_STROKE=8
