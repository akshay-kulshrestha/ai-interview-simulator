# Copy this file to .env and adjust as needed. Values here are the same
# defaults already baked into the code -- uncomment/edit only what you want
# to change. Never commit your actual .env (add it to .gitignore).

# ---------------------------------------------------------------- AI ------
# No API key or external service needed. Question generation comes from a
# local question bank; answer scoring uses a real (if lightweight) ML
# technique -- TF-IDF vectorization + cosine similarity via scikit-learn,
# fit entirely locally at startup from the question bank itself. No
# network call, no download beyond the pip package.

# --------------------------------------------------------------- storage ---
# DATABASE_PATH=./data/interviews.db
# DB_BUSY_TIMEOUT_MS=5000
# REPORTS_DIR=./reports

# ------------------------------------------------------------------- app ---
# PORT=5001
# FLASK_DEBUG=0
# SCORE_RING_SIZE=96
# SCORE_RING_STROKE=8
