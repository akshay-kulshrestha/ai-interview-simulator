# Copy this file to .env and adjust as needed. Values here are the same
# defaults already baked into the code -- uncomment/edit only what you want
# to change. Never commit your actual .env (add it to .gitignore).

# ------------------------------------------------------------- Anthropic --
# Required -- get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here
# Haiku is the default: this app makes many small, structured calls per
# session rather than a few large ones, so per-call cost/latency matter
# more than reasoning depth on a task this constrained. Bump to a larger
# model (e.g. claude-sonnet-4-5) if you want higher-quality feedback and
# don't mind the extra cost/latency per call.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_REQUEST_TIMEOUT=90

# ------------------------------------------------- generation length caps --
# Raising these gives the model more room per call (less truncation risk)
# at the cost of slightly higher token cost; lowering reduces cost but
# raises truncation risk. See ai_analyzer.py for how these interact.
# WARMUP_NUM_PREDICT=10
# QUESTION_NUM_PREDICT=90
# HINTS_NUM_PREDICT=120
# ANALYSIS_NUM_PREDICT=450
# SUMMARY_NUM_PREDICT=220

# ------------------------------------------------------- retries & counts --
# QUESTION_GENERATION_ATTEMPTS=3
# HINTS_GENERATION_ATTEMPTS=2
# MAX_HINTS=3
# MAX_STRENGTHS=6
# MAX_SUGGESTIONS=6
# PROMPT_LIST_ITEM_COUNT=2
# IMPROVED_ANSWER_MAX_WORDS=70
# MIN_IMPROVED_ANSWER_WORDS=8

# --------------------------------------------------------------- storage ---
# DATABASE_PATH=./data/interviews.db
# DB_BUSY_TIMEOUT_MS=5000
# REPORTS_DIR=./reports

# ------------------------------------------------------------------- app ---
# PORT=5001
# FLASK_DEBUG=0
# SCORE_RING_SIZE=96
# SCORE_RING_STROKE=8
